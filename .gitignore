# ===== 构建产物 / 二进制（不入库）=====

# fpk 打包产物
*.fpk

# cron 会话快照（Hermes 运行时生成，日期时间戳格式无扩展名）
[0-9]*_[0-9]*_[0-9a-f]*

# Go 构建产物
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# metacubexd 编译产物（server / ui 静态资源，由 build.sh 生成）
src/app/server/
src/app/www/
src/app/bin/

# dist 产物目录
dist/

# ===== develop/ 构建环境中间产物（NAS 构建时下载/生成，不入库）=====

# gh-proxy 下载产物（源码包、内核压缩包等，统一放 download/）
develop/download/

# 下载的归档（兼容旧位置残留：脚本早期版本下载到 develop/ 根，现归 download/）
develop/metacubexd-*.tar.gz
develop/mihomo-*.gz

# metacubexd 源码（解包自 download/ 下的源码包）
develop/metacubexd/

# gh-proxy 运行时缓存（测速结果等；文件名由 cache_path 配置决定，默认在二进制旁）
develop/.gh_proxy
develop/.gh_proxy.*
develop/gh-proxy-cache*

# gh-proxy 镜像配置（可选；若放置则可能含 github_token，敏感）
develop/config.json

# 构建日志
develop/build.log

# build.sh 用的全局 git 配置（规避 dubious ownership，落在 develop/ 下）
develop/.gitconfig-global

# ===== 编辑器 / 工具 =====

# ZCode agent workspace
.zcode/

# 日志
*.log
