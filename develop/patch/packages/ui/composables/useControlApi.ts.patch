+  let mountPath = loc?.pathname ?? '/'
+  if (!mountPath.startsWith('/')) mountPath = '/' + mountPath
+  mountPath = mountPath.replace(/\/+$/, '')
   // All-in-One server mode: the dashboard is served same-origin with the agent,
