#!/bin/bash

# MetaCubeXD fnOS 应用 - 升级回调
#
# 升级时无需任何动作：
#   - 面板产物（server/www）随 fpk 部署到 app/，升级时由 fnOS 自动覆盖
#   - 运行时数据（profiles/active.yaml/geoip）在 appshare/，升级不影响
#
# 历史上此回调会在 NAS 上重新拉取上游源码 + 重建面板，现废弃：
#   - 消除对 gh-mirror（已替换为 gh-proxy，且 develop/ 专用）的运行时依赖
#   - 避免 NAS 端构建的不确定性（依赖 corepack/pnpm/网络）
# 新版面板直接打进 fpk，升级即生效，无需重建。
#
# 注：mihomo 内核不会随升级自动更新（install_callback 仅在首次安装时把
#     app/bin/mihomo 复制到 appshare/bin/）。如需升级内核，卸载重装。

exit 0
